{
	"schemaVersion": 1,
	"id": "btessentials",
	"version": "${version}",
	"name": "Better Than Essentials",
	"description": "An Essentials-like plugin for Better Than Adventure servers!",
	"authors": [
		"wyspr"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/preprocessor/BetterThanEssentialsa"
	},
	"license": "CC0-1.0",
	"environment": "server",
	"entrypoints": {
		"server": [
			"wyspr.BTE.Essentials"
		],
